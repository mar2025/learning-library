{
  "name": "oracle-learning-library-build-tools",
  "version": "1.0.0",
  "description": "Performance optimization tools for Oracle Learning Library",
  "main": "optimize-images.js",
  "scripts": {
    "optimize:images": "node optimize-images.js",
    "optimize:css": "node bundle-css.js",
    "optimize:js": "node bundle-js.js",
    "optimize:all": "npm run optimize:css && npm run optimize:js && npm run optimize:images",
    "analyze": "node analyze-performance.js",
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development --watch"
  },
  "keywords": [
    "performance",
    "optimization",
    "images",
    "webpack",
    "css",
    "javascript"
  ],
  "author": "Oracle Learning Library Team",
  "license": "UPL-1.0",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "cssnano": "^6.0.1",
    "file-loader": "^6.2.0",
    "glob": "^10.3.10",
    "html-webpack-plugin": "^5.5.3",
    "imagemin": "^8.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-svgo": "^10.0.1",
    "imagemin-webp": "^8.0.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "postcss-preset-env": "^9.3.0",
    "sharp": "^0.32.6",
    "terser-webpack-plugin": "^5.3.9",
    "url-loader": "^4.1.1",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.9.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "fs-extra": "^11.1.1",
    "node-sass": "^9.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}